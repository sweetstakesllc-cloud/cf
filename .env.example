# Shopify Storefront API — copy to `.env` and fill in.
# `.env` is gitignored; `.env.example` is committed as the template.
#
# Get these from Shopify admin:
#   Settings → Apps and sales channels → Develop apps → your app
#   → API credentials → Storefront API access token
# (Use the STOREFRONT token, which is publishable — NOT the Admin API token.)

EXPO_PUBLIC_SHOPIFY_DOMAIN=circularfash.com
EXPO_PUBLIC_SHOPIFY_TOKEN=your_storefront_api_access_token_here

# Optional — pin the Storefront API version (defaults to 2026-04 in code).
# EXPO_PUBLIC_SHOPIFY_API_VERSION=2026-04
