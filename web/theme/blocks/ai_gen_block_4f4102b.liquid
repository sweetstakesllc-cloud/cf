{% doc %}
  @prompt
    I want to have three different symbols with text in a row with a symbol on top of each text One "Authentic" with a swoosh/check mark. Two "Refreshed" in line with a cleaning symbol. three "Fast Delivery" with a delivery car, vertical, in line , the symbols should be displayed in a row. Look should be bit more luxurious, de ska vara uppradade alltså först authentic sedan refreshed och slutligen fast delivery. man ska alltså inte behöva scrolla ner för att se alla utan alla på en rad, make it smaller so everything fits and looks proportional with the rest of the website, make the background white. now its grey
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-luxury-features-{{ ai_gen_id }} {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    gap: {{ block.settings.spacing }}px;
    padding: {{ block.settings.padding_top }}px 40px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    flex-wrap: nowrap;
    overflow-x: auto;
  }

  .ai-luxury-feature-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    flex: 1 1 0;
    min-width: 0;
    max-width: 200px;
    position: relative;
  }

  .ai-luxury-feature-item-{{ ai_gen_id }}:not(:last-child)::after {
    content: '';
    position: absolute;
    right: calc(-{{ block.settings.spacing }}px / 2);
    top: 50%;
    transform: translateY(-50%);
    width: 1px;
    height: 60%;
    background-color: {{ block.settings.divider_color }};
    opacity: {{ block.settings.divider_opacity | divided_by: 100.0 }};
  }

  .ai-luxury-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-luxury-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    color: {{ block.settings.icon_color }};
    stroke-width: 1.5;
  }

  .ai-luxury-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    font-weight: {{ block.settings.text_weight }};
    line-height: 1.3;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    text-transform: {{ block.settings.text_transform }};
  }

  @media screen and (max-width: 749px) {
    .ai-luxury-features-{{ ai_gen_id }} {
      gap: {{ block.settings.spacing | times: 0.6 }}px;
      padding-left: 20px;
      padding-right: 20px;
    }

    .ai-luxury-feature-item-{{ ai_gen_id }} {
      min-width: 80px;
      max-width: 120px;
    }

    .ai-luxury-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.7 }}px;
      height: {{ block.settings.icon_size | times: 0.7 }}px;
    }

    .ai-luxury-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.text_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-luxury-features-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-luxury-feature-item-{{ ai_gen_id }}">
    <div class="ai-luxury-icon-wrapper-{{ ai_gen_id }}">
      <svg class="ai-luxury-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <div class="ai-luxury-text-{{ ai_gen_id }}">{{ block.settings.feature_1_text }}</div>
  </div>

  <div class="ai-luxury-feature-item-{{ ai_gen_id }}">
    <div class="ai-luxury-icon-wrapper-{{ ai_gen_id }}">
      <svg class="ai-luxury-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
      </svg>
    </div>
    <div class="ai-luxury-text-{{ ai_gen_id }}">{{ block.settings.feature_2_text }}</div>
  </div>

  <div class="ai-luxury-feature-item-{{ ai_gen_id }}">
    <div class="ai-luxury-icon-wrapper-{{ ai_gen_id }}">
      <svg class="ai-luxury-icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
        <rect x="1" y="3" width="15" height="13"></rect>
        <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
        <circle cx="5.5" cy="18.5" r="2.5"></circle>
        <circle cx="18.5" cy="18.5" r="2.5"></circle>
      </svg>
    </div>
    <div class="ai-luxury-text-{{ ai_gen_id }}">{{ block.settings.feature_3_text }}</div>
  </div>
</div>

{% schema %}
{
  "name": "Luxury feature icons",
  "settings": [
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "text",
      "id": "feature_1_text",
      "label": "Feature 1 text",
      "default": "Authentic"
    },
    {
      "type": "text",
      "id": "feature_2_text",
      "label": "Feature 2 text",
      "default": "Refreshed"
    },
    {
      "type": "text",
      "id": "feature_3_text",
      "label": "Feature 3 text",
      "default": "Fast Delivery"
    },
    {
      "type": "header",
      "content": "Icon style"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 40
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#1a1a1a"
    },
    {
      "type": "range",
      "id": "icon_spacing",
      "min": 4,
      "max": 24,
      "step": 2,
      "unit": "px",
      "label": "Space below icon",
      "default": 10
    },
    {
      "type": "header",
      "content": "Text style"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 12
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#1a1a1a"
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Text weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        },
        {
          "value": "capitalize",
          "label": "Capitalize"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "min": 0,
      "max": 2,
      "step": 0.5,
      "unit": "px",
      "label": "Letter spacing",
      "default": 0.5
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "spacing",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Space between items",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 28
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Borders and dividers"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#d0d0d0"
    },
    {
      "type": "range",
      "id": "divider_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Divider opacity",
      "default": 30
    }
  ],
  "presets": [
    {
      "name": "Luxury feature icons"
    }
  ]
}
{% endschema %}
