{% doc %}
  @prompt
    separator line
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-separator-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.spacing_top }}px 0 {{ block.settings.spacing_bottom }}px;
  }

  .ai-separator-line-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    height: {{ block.settings.line_thickness }}px;
    background-color: {{ block.settings.line_color }};
    margin: 0 auto;
    border: none;
    {% if block.settings.line_style == 'dashed' %}
      background: none;
      border-top: {{ block.settings.line_thickness }}px dashed {{ block.settings.line_color }};
      height: 0;
    {% elsif block.settings.line_style == 'dotted' %}
      background: none;
      border-top: {{ block.settings.line_thickness }}px dotted {{ block.settings.line_color }};
      height: 0;
    {% endif %}
  }

  @media screen and (max-width: 749px) {
    .ai-separator-line-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-separator-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <hr class="ai-separator-line-{{ ai_gen_id }}">
</div>

{% schema %}
{
  "name": "Separator line",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Line style"
    },
    {
      "type": "select",
      "id": "line_style",
      "label": "Style",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "dashed",
          "label": "Dashed"
        },
        {
          "value": "dotted",
          "label": "Dotted"
        }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "line_thickness",
      "label": "Thickness",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Separator line"
    }
  ]
}
{% endschema %}
