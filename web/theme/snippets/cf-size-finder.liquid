{%- liquid
  assign category = product.category.name | downcase
  assign words = product.title | append: ' ' | append: product.type | downcase
  assign clothing = false
  assign clothing_category = false
  if product.category.id == 'aa-1'
    assign clothing_category = true
  endif
  for ancestor in product.category.ancestors
    if ancestor.id == 'aa-1'
      assign clothing_category = true
    endif
  endfor
  if clothing_category
    assign clothing = true
  elsif category == blank or category == 'uncategorized'
    assign clothing_words = 'jacket,hoodie,sweatshirt,t-shirt,t shirt,polo,cardigan,sweater,knitwear,coat,vest,shirt,trousers,jeans,shorts,dress,skirt,blazer,joggers,tracksuit' | split: ','
    for word in clothing_words
      if words contains word
        assign clothing = true
      endif
    endfor
    assign excluded_words = 'bag,sneaker,shoe,boot,wallet,belt,scarf,cap,hat'
    assign excluded_words = excluded_words | split: ','
    for word in excluded_words
      if words contains word
        assign clothing = false
      endif
    endfor
  endif
-%}
{%- if clothing -%}
  {{ 'cf-size-finder.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'cf-size-finder.js' | asset_url }}" defer="defer"></script>
  <cf-size-finder
    data-title="{{ product.title | escape }}"
    data-category="{{ category | escape }}"
    data-description="{{ product.description | strip_html | escape }}"
    data-options="{{ product.options | json | escape }}"
    data-variants="{{ product.variants | json | escape }}"
    data-pit="{{ product.metafields.custom.pit.value | escape }}"
    data-chest="{{ product.metafields.custom.chest.value | escape }}"
    data-length="{{ product.metafields.custom.length.value | escape }}"
    data-waist="{{ product.metafields.custom.waist.value | escape }}"
  >
    <button type="button" class="cf-size__open" aria-haspopup="dialog" hidden>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="2"/><path d="M7 7v5m5-5v3m5-3v5"/></svg>
      Find my size <span aria-hidden="true">↗</span>
    </button>
    <dialog class="cf-size__dialog" aria-labelledby="cf-size-title-{{ section_id }}">
      <div class="cf-size__head"><span>CIRCULAR FASH · FIT GUIDE</span><button class="cf-size__close" type="button" aria-label="Close size finder">×</button></div>
      <h2 id="cf-size-title-{{ section_id }}">Find your fit.</h2>
      <p class="cf-size__intro">A little guidance for a one-of-a-kind piece.</p>
      <p class="cf-size__product">{{ product.title | escape }}</p>
      <form class="cf-size__form">
        <div class="cf-size__grid">
          <label>Height (cm)<input name="height" type="number" min="120" max="230" step="1" inputmode="numeric" placeholder="180" required></label>
          <label>Weight (kg)<input name="weight" type="number" min="30" max="250" step="0.1" inputmode="decimal" placeholder="75" required></label>
          <label>Sizing reference<select name="reference"><option value="men">Adult men's / unisex</option><option value="women">Adult women's</option></select></label>
          <label>Preferred fit<select name="fit"><option value="regular">Regular</option><option value="close">Closer fit</option><option value="relaxed">Relaxed</option></select></label>
        </div>
        <label>Your usual letter size <span>(optional)</span><select name="usual"><option value="">I'm not sure</option><option>XXS</option><option>XS</option><option>S</option><option>M</option><option>L</option><option>XL</option><option>XXL</option><option>3XL</option></select></label>
        <details class="cf-size__details"><summary>Improve the estimate with a garment you own</summary>
          <p>Use a similar item that fits the way you like. Lay it flat, without stretching. All measurements are in cm.</p>
          <div class="cf-size__grid">
            <label data-top-measure>Armpit to armpit<input name="pit" type="number" min="20" max="100" step="0.1" inputmode="decimal" placeholder="e.g. 54"></label>
            <label data-top-measure>Shoulder to hem<input name="length" type="number" min="20" max="180" step="0.1" inputmode="decimal" placeholder="e.g. 70"></label>
          </div>
          <p data-bottom-note hidden>For bottoms, compare the listing's waist, rise and inside-leg measurements with your own trousers. Height and weight cannot determine your waist size.</p>
        </details>
        <button class="cf-size__submit" type="submit">Find my fit <span aria-hidden="true">→</span></button>
      </form>
      <div class="cf-size__result" role="status" aria-live="polite" tabindex="-1" hidden></div>
      <p class="cf-size__privacy">Your entries stay in this page and are cleared when you leave. This is an approximate fit guide, not a guarantee.</p>
    </dialog>
  </cf-size-finder>
{%- endif -%}
