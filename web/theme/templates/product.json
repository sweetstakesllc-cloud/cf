        "custom_liquid_9PUt66": {
          "type": "custom_liquid",
          "name": "Retail Price",
          "settings": {
            "alignment": "center",
            "custom_liquid": "{% comment %}\n  CONFIGURATION:\n  1. We assume your metafield namespace is 'custom'.\n     If you created it differently, change 'custom' to 'my_fields' or your specific namespace.\n  2. Exchange rates set for Jan 2026.\n{% endcomment %}\n\n{% assign retail_price_sek = product.metafields.custom.retail_price.value %}\n\n{% if retail_price_sek != blank %}\n    <p style=\"margin-bottom: 5px;\"><strong>Retail Price:</strong></p>\n\n  <div class=\"retail-price-display\" style=\"margin-top: 10px; font-size: 0.6em; opacity: 0.8;\">\n\n    \n    <span style=\"margin-right: 5px;\">\n      {{ retail_price_sek }} SEK\n    </span>\n\n    {% comment %} Exchange Rates (Hardcoded) {% endcomment %}\n    {% assign rate_eur = 0.094 %}\n    {% assign rate_gbp = 0.082 %}\n    {% assign rate_usd = 0.110 %}\n\n    {% assign price_eur = retail_price_sek | times: rate_eur | round %}\n    <span style=\"margin-right: 5px;\">\n      |&nbsp; €{{ price_eur }} EUR\n    </span>\n\n    {% assign price_gbp = retail_price_sek | times: rate_gbp | round %}\n    <span style=\"margin-right: 5px;\">\n      |&nbsp; £{{ price_gbp }} GBP\n    </span>\n\n    {% assign price_usd = retail_price_sek | times: rate_usd | round %}\n    <span>\n      |&nbsp; ${{ price_usd }} USD\n    </span>\n  </div>\n{% endif %}"
          }
        },
