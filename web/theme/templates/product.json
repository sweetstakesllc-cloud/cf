      <a href=\"{{ target_col.url }}\" class=\"custom-brand-btn\" title=\"View {{ target_col.title }}\">\n            {{ target_col.image | image_url: width: 160 | image_tag: loading: 'lazy' }}\n          </a>\n        {%- endif -%}\n      {%- endfor -%}\n    \n    {%- else -%}\n      {%- comment -%} Fallback for Single Item {%- endcomment -%}\n      {%- assign target_col = brand_list.collection.value -%}\n      {%- if target_col and target_col.image -%}\n        <a href=\"{{ target_col.url }}\" class=\"custom-brand-btn\" title=\"View {{ target_col.title }}\">\n          {{ target_col.image | image_url: width: 160 | image_tag: loading: 'lazy' }}\n        </a>\n      {%- endif -%}\n    {%- endif -%}\n\n  </div>\n{%- endif -%}"
