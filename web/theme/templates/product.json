          "disabled": true
        },
        "cf_trust": {
          "type": "custom_liquid",
          "name": "CF trust block",
          "settings": {
            "alignment": "center",
            "custom_liquid": "<div class='cf-trust'><span class='cf-tick'>\u2713</span><div><h4>Authenticated by Circular Fash</h4><p>Every item is inspected and verified by our experts before listing. If it isn't genuine, it isn't here. <a href='/pages/authenticity'>Our process</a></p></div></div>"
          }
        },
        "cf_klarna": {
          "type": "custom_liquid",
          "settings": {
            "alignment": "center",
            "custom_liquid": "{% comment %}\n  Klarna reassurance beside the buy button.\n\n  Gated on shop.enabled_payment_types so the badge cannot outlive the payment\n  method: if Klarna is ever switched off in Shopify, this disappears with it\n  rather than advertising something checkout will not offer. The mark comes\n  from Shopify's own payment_type_svg_tag, so it is the licensed asset and\n  stays correct if Klarna restyles it.\n\n  Deliberately says only that Klarna is available. Instalment counts and\n  interest terms vary by market and by the merchant's Klarna agreement, and\n  stating them here would be a claim we cannot verify from the theme.\n{% endcomment %}\n{%- if shop.enabled_payment_types contains 'klarna' -%}\n  <div class=\"cf-klarna\">\n    {{ 'klarna' | payment_type_svg_tag: class: 'cf-klarna-mark' }}\n    <span>Pay with Klarna at checkout</span>\n  </div>\n{%- endif -%}"
          }
        },
        "cf_specs": {
          "type": "custom_liquid",
          "settings": {
            "alignment": "center",
            "custom_liquid": "{% comment %}\n  One spec table, replacing thirteen separate blocks that each printed a\n  sentence. Measurements, condition, retail, origin and item id were rendered\n  as loose lines of running text with bold labels, so the page read as a\n  paragraph pile rather than a product record. A luxury resale page lives on\n  this being scannable.\n\n  Metafields are read by bracket lookup so the labels and keys stay in one\n  list. cm/inch handling is the same as the blocks it replaces: whole numbers\n  lose their .0, halves keep it.\n{% endcomment %}\n\n{%- liquid\n  assign m_keys   = 'pit,chest,waist,shoulder,length,width,height,innerleg,insole' | split: ','\n  assign m_labels = 'Pit to pit,Chest,Waist,Shoulder,Length,Width,Height,Inner leg,Insole' | split: ','\n  assign rows = ''\n-%}\n\n<dl class=\"cf-specs\">\n  {%- assign cond = product.metafields.custom.condition.value.name.value -%}\n  {%- if cond != blank -%}\n    <div class=\"cf-specs__row\"><dt>Condition</dt><dd>{{ cond }}</dd></div>\n  {%- endif -%}\n\n  {%- comment -%}\n    Options are listed only when there is nothing to choose. Most pieces are\n    one of one, so the size belongs in the record; but 9 in-stock products have\n    several buyable variants, and for those the picker above owns the choice.\n    Printing a fixed \"Size L\" beside a picker offering M and L is worse than\n    saying nothing.\n  {%- endcomment -%}\n  {%- if product.variants.size == 1 -%}\n    {%- for opt in product.options_with_values -%}\n      {%- if opt.name != 'Title' -%}\n        <div class=\"cf-specs__row\"><dt>{{ opt.name }}</dt><dd>{{ opt.selected_value }}</dd></div>\n      {%- endif -%}\n    {%- endfor -%}\n  {%- endif -%}\n\n  {%- for key in m_keys -%}\n    {%- assign raw_val = product.metafields.custom[key].value | default: product.metafields.custom[key] -%}\n    {%- if raw_val != blank -%}\n      {%- liquid\n        assign num = raw_val | plus: 0\n        assign cm_rem = num | modulo: 1\n        if cm_rem == 0\n          assign cm = num | round\n        else\n          assign cm = num\n        endif\n        assign inch = num | divided_by: 2.54 | round: 1\n        assign in_rem = inch | modulo: 1\n        if in_rem == 0\n          assign inch = inch | round\n        endif\n      -%}\n      <div class=\"cf-specs__row\">\n        <dt>{{ m_labels[forloop.index0] }}</dt>\n        <dd>{{ cm }} cm <span class=\"cf-specs__alt\">/ {{ inch }} in</span></dd>\n      </div>\n    {%- endif -%}\n  {%- endfor -%}\n\n  {%- if product.metafields.custom.made_in != blank -%}\n    <div class=\"cf-specs__row\"><dt>Made in</dt><dd>{{ product.metafields.custom.made_in }}</dd></div>\n  {%- endif -%}\n\n  {%- assign retail_raw = product.metafields.custom.retail_price.value -%}\n  {%- if retail_raw != blank -%}\n    {%- assign retail_round = retail_raw | plus: 0 | round -%}\n    <div class=\"cf-specs__row\">\n      <dt>Est. retail price</dt>\n      <dd><span data-retail-sek=\"{{ retail_round }}\">{{ retail_round }} SEK</span></dd>\n    </div>\n  {%- endif -%}\n\n  {%- comment -%} The item id is written into the description, not a field. {%- endcomment -%}\n  {%- if product.description contains 'ID: ' -%}\n    {%- assign after = product.description | split: 'ID: cf' | last -%}\n    {%- assign item_id = after | split: ' ' | first | remove: '.' | remove: ',' | remove: '<' | strip -%}\n    {%- if item_id != blank -%}\n      <div class=\"cf-specs__row\"><dt>Item</dt><dd>cf{{ item_id }}</dd></div>\n    {%- endif -%}\n  {%- endif -%}\n</dl>"
          }
        }
      },
