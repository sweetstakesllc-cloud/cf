        "custom_liquid_rUQcmx": {
          "type": "custom_liquid",
          "name": "Condition",
          "disabled": true,
          "settings": {
            "alignment": "left",
            "custom_liquid": "{% comment %} --- CONDITION STAR RATING (1-10 Scale) --- {% endcomment %}\n\n{% comment %} 1. Get the Metaobject {% endcomment %}\n{% assign condition_obj = product.metafields.custom.condition.value %}\n\n{% if condition_obj != blank and condition_obj.value != blank %}\n\n  {% comment %} 2. Math: Convert 1-10 scale to 1-5 scale {% endcomment %}\n  {% assign raw_score = condition_obj.value | plus: 0 %}\n  {% assign scaled_score = raw_score | divided_by: 2.0 %}\n\n  {% comment %} 3. Logic: Calculate Full, Half, and Empty stars {% endcomment %}\n  {% assign full_stars = scaled_score | floor %}\n  {% assign decimal_part = scaled_score | minus: full_stars %}\n  \n  {% assign has_half_star = false %}\n  {% if decimal_part >= 0.25 and decimal_part < 0.75 %}\n    {% assign has_half_star = true %}\n  {% elsif decimal_part >= 0.75 %}\n    {% assign full_stars = full_stars | plus: 1 %}\n  {% endif %}\n\n  {% assign empty_stars = 5 | minus: full_stars %}\n  {% if has_half_star %}\n    {% assign empty_stars = empty_stars | minus: 1 %}\n  {% endif %}\n\n  <div class=\"condition-rating\" style=\"display: flex; align-items: center; gap: 8px; margin-top: 5px;\">\n    <strong></strong>\n    \n    <div class=\"stars-container\" style=\"display: flex; color: #F5C518;\">\n      \n      {% comment %} RENDER FULL STARS {% endcomment %}\n      {% if full_stars > 0 %}\n        {% for i in (1..full_stars) %}\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n        {% endfor %}\n      {% endif %}\n\n      {% comment %} RENDER HALF STAR {% endcomment %}\n      {% if has_half_star %}\n        <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\">\n          <defs><clipPath id=\"half-star\"><rect x=\"0\" y=\"0\" width=\"12\" height=\"24\" /></clipPath></defs>\n          <path d=\"M22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24zM12 15.4l-3.76 2.27 1-4.28-3.32-2.88 4.38-.38L12 6.1l1.71 4.01 4.38.38-3.32 2.88 1 4.28L12 15.4z\" opacity=\"0.3\"/>\n          <path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\" clip-path=\"url(#half-star)\"/>\n        </svg>\n      {% endif %}\n\n      {% comment %} RENDER EMPTY STARS {% endcomment %}\n      {% if empty_stars > 0 %}\n        {% for i in (1..empty_stars) %}\n          <svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"currentColor\" opacity=\"0.3\"><path d=\"M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z\"/></svg>\n        {% endfor %}\n      {% endif %}\n\n    </div>\n    \n    {% comment %} Text Label (e.g., 9/10) {% endcomment %}\n    <span style=\"font-size: 0.9em; opacity: 0.8;\">({{ raw_score }}/10)</span>\n\n  </div>\n\n{% endif %}"
          }
