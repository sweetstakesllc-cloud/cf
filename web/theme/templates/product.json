            "custom_liquid": "{% comment %} \n  We pull the cost from the first available variant. \n{% endcomment %}\n{% assign cost_price_sek = product.selected_or_first_available_variant.inventory_item.unit_cost %}\n\n{% if cost_price_sek != blank %}\n  <p style=\"margin-bottom: 5px;\"><strong>Cost per Item:</strong></p>\n\n  <div class=\"cost-price-display\" style=\"margin-top: 10px; font-size: 0.6em; opacity: 0.8;\">\n    <span style=\"margin-right: 5px;\">\n      {{ cost_price_sek | money_without_currency }} SEK\n    </span>\n\n    {% comment %} Exchange Rates {% endcomment %}\n    {% assign rate_eur = 0.094 %}\n    {% assign rate_gbp = 0.082 %}\n    {% assign rate_usd = 0.110 %}\n\n    {% comment %} \n      Note: We convert to a number using | plus: 0 to ensure math works \n    {% endcomment %}\n    {% assign raw_cost = cost_price_sek | plus: 0 %}\n\n    {% assign cost_eur = raw_cost | times: rate_eur | round: 2 %}\n    <span style=\"margin-right: 5px;\">\n      |&nbsp; €{{ cost_eur }} EUR\n    </span>\n\n    {% assign cost_gbp = raw_cost | times: rate_gbp | round: 2 %}\n    <span style=\"margin-right: 5px;\">\n      |&nbsp; £{{ cost_gbp }} GBP\n    </span>\n\n    {% assign cost_usd = raw_cost | times: rate_usd | round: 2 %}\n    <span>\n      |&nbsp; ${{ cost_usd }} USD\n    </span>\n  </div>\n{% endif %}"
          }
        },
