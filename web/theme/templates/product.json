        "custom_liquid_9PUt66": {
          "type": "custom_liquid",
          "name": "Retail Price",
          "settings": {
            "alignment": "center",
            "custom_liquid": "{% comment %}\n  Condition and estimated retail, as two centred spec rows matching the\n  measurement rows above them.\n\n  The old version printed the raw metafield (\"3000.0 SEK\") and then converted it\n  with exchange rates hardcoded in January 2026. Those rates drift, and the shop\n  now has a real currency switcher, so a stale EUR figure sitting next to a live\n  one is worse than no figure. The value is rendered in SEK and converted at\n  runtime with Shopify.currency.rate, which is the same rate the shopper is\n  actually being charged at. No JS, no conversion: it stays SEK and stays true.\n{% endcomment %}\n\n{%- assign cond = product.metafields.custom.condition.value.name.value -%}\n{%- assign retail = product.metafields.custom.retail_price.value -%}\n\n{%- if cond != blank -%}\n  <p class=\"cf-spec\"><strong>Condition:</strong> {{ cond }}</p>\n{%- endif -%}\n\n{%- if retail != blank -%}\n  {%- assign retail_round = retail | round -%}\n  <p class=\"cf-spec cf-retail\">\n    <strong>Est. retail price:</strong>\n    <span class=\"cf-retail-value\" data-retail-sek=\"{{ retail_round }}\">{{ retail_round }} SEK</span>\n  </p>\n{%- endif -%}"
          },
          "disabled": true
        },
