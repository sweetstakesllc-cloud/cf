          "name": "Pit to Pit",
          "settings": {
            "alignment": "center",
            "custom_liquid": "{% comment %} 1. Get the value safely (handles both 'Decimal' and 'Text' types) {% endcomment %}\n{% assign raw_pit = product.metafields.custom.pit.value | default: product.metafields.custom.pit %}\n\n{% if raw_pit != blank %}\n  \n  {% comment %} Ensure it is treated as a number {% endcomment %}\n  {% assign pit_num = raw_pit | plus: 0 %}\n\n  {% comment %} --- LOGIC FOR CM --- {% endcomment %}\n  {% comment %} Check if dividing by 1 leaves a remainder. If 0, it's a whole number. {% endcomment %}\n  {% assign cm_remainder = pit_num | modulo: 1 %}\n  \n  {% if cm_remainder == 0 %}\n    {% assign display_cm = pit_num | round %} {% comment %} Turns 50.0 into 50 {% endcomment %}\n  {% else %}\n    {% assign display_cm = pit_num %}         {% comment %} Keeps 50.5 as 50.5 {% endcomment %}\n  {% endif %}\n\n  {% comment %} --- LOGIC FOR INCHES --- {% endcomment %}\n  {% assign inches_num = pit_num | divided_by: 2.54 | round: 1 %}\n  {% assign in_remainder = inches_num | modulo: 1 %}\n\n  {% if in_remainder == 0 %}\n    {% assign display_in = inches_num | round %}\n  {% else %}\n    {% assign display_in = inches_num %}\n  {% endif %}\n\n  <div class=\"product-measurement\"><strong>Pit to Pit:</strong> {{ display_cm }} cm / {{ display_in }} Inches\n  </div>\n\n{% endif %}"
          }
