            "custom_liquid": "{% comment %}\n  -------------------------------------------------------\n  CONFIGURATION: Change these numbers to adjust the design\n  -------------------------------------------------------\n{% endcomment %}\n{% liquid\n  assign icon_size = 60         \n  assign icon_radius = 8        \n  assign icon_gap = 12          \n  assign align_content = 'flex-start' \n  assign bg_color = '#F4F4F4'\n  assign shadow_opacity = 0.1   \n%}\n\n{% comment %} \n  Valid alignment options: \n  'flex-start' (Left), 'center' (Center), 'flex-end' (Right)\n  \n  Valid radius:\n  0 (Square) to 50 (Circle)\n{% endcomment %}\n\n<style>\n  .custom-brand-widget {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: {{ icon_gap }}px;\n    justify-content: {{ align_content }};\n    margin-bottom: 1.5rem; /* Space below the widget */\n  }\n\n  .custom-brand-btn {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: {{ icon_size }}px;\n    height: {{ icon_size }}px;\n    background-color: {{ bg_color }};\n    border-radius: {{ icon_radius }}px;\n    box-shadow: 0 2px 5px rgba(0,0,0, {{ shadow_opacity }});\n    text-decoration: none;\n    transition: transform 0.2s ease, opacity 0.2s ease;\n    overflow: hidden;\n  }\n\n  .custom-brand-btn:hover {\n    transform: translateY(-2px);\n    opacity: 0.9;\n  }\n\n  .custom-brand-btn img {\n    width: 100%;\n    height: 100%;\n    object-fit: contain; \n    padding: 6px; /* Padding inside the button so logo fits nicely */\n    display: block;\n  }\n</style>\n\n{%- assign brand_list = product.metafields.custom.brands.value -%}\n\n{%- if brand_list != blank -%}\n  <div class=\"custom-brand-widget\">\n    \n    {%- comment -%} Check if it is a List or Single Item {%- endcomment -%}\n    {%- if brand_list.count -%}\n      {%- for brand in brand_list -%}\n        {%- assign target_col = brand.collection.value -%}\n        {%- if target_col and target_col.image -%}\n          <a href=\"{{ target_col.url }}\" class=\"custom-brand-btn\" title=\"View {{ target_col.title }}\">\n            {{ target_col.image | image_url: width: 160 | image_tag: loading: 'lazy' }}\n          </a>\n        {%- endif -%}\n      {%- endfor -%}\n    \n    {%- else -%}\n      {%- comment -%} Fallback for Single Item {%- endcomment -%}\n      {%- assign target_col = brand_list.collection.value -%}\n      {%- if target_col and target_col.image -%}\n        <a href=\"{{ target_col.url }}\" class=\"custom-brand-btn\" title=\"View {{ target_col.title }}\">\n          {{ target_col.image | image_url: width: 160 | image_tag: loading: 'lazy' }}\n        </a>\n      {%- endif -%}\n    {%- endif -%}\n\n  </div>\n{%- endif -%}"
