          "settings": {
            "alignment": "center",
            "custom_liquid": "{% comment %} \n  We pull the cost from the first available variant. \n{% endcomment %}\n{% assign cost_price_sek = product.selected_or_first_available_variant.inventory_item.unit_cost %}\n\n{% if cost_price_sek != blank %}\n  <p style=\"margin-bottom: 5px;\"><strong>Cost per Item:</strong></p>\n\n  <div class=\"cost-price-display\" style=\"margin-top: 10px; font-size: 0.6em; opacity: 0.8;\">\n    <span style=\"margin-right: 5px;\">\n      {{ cost_price_sek | money_without_currency }} SEK\n    </span>\n\n    {% comment %} Exchange Rates {% endcomment %}\n    {% assign rate_eur = 0.094 %}\n    {% assign rate_gbp = 0.082 %}\n    {% assign rate_usd = 0.110 %}\n\n    {% comment %} \n      Note: We convert to a number using | plus: 0 to ensure math works \n    {% endcomment %}\n    {% assign raw_cost = cost_price_sek | plus: 0 %}\n\n    {% assign cost_eur = raw_cost | times: rate_eur | round: 2 %}\n    <span style=\"margin-right: 5px;\">\n      |&nbsp; \u20ac{{ cost_eur }} EUR\n    </span>\n\n    {% assign cost_gbp = raw_cost | times: rate_gbp | round: 2 %}\n    <span style=\"margin-right: 5px;\">\n      |&nbsp; \u00a3{{ cost_gbp }} GBP\n    </span>\n\n    {% assign cost_usd = raw_cost | times: rate_usd | round: 2 %}\n    <span>\n      |&nbsp; ${{ cost_usd }} USD\n    </span>\n  </div>\n{% endif %}"
          },
          "disabled": true
        },
        "custom_liquid_TtrxLt": {
          "type": "custom_liquid",
          "name": "SKU",
          "disabled": true,
          "settings": {
            "alignment": "center",
            "custom_liquid": "{% assign block_of_text = product.description %} {% if block_of_text contains \"ID: \" %}\n  {% assign text_after_id = block_of_text | split: \"ID: cf\" | last %}\n  \n  {% assign custom_sku = text_after_id | split: \" \" | first | remove: \".\" | remove: \",\" | remove: \"<\" | strip %}\n  \n  SKU: {{ custom_sku }}\n{% endif %}"
          }
        },
        "sku_ereHMA": {
          "type": "sku",
          "settings": {
            "alignment": "center",
