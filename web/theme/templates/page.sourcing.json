/*
 * ------------------------------------------------------------
 * Sourcing Requests — its own page, which is what the client asked
 * for. This is the contact-form section that used to sit at the
 * bottom of Sell To Us (and, via the shared default template, at the
 * bottom of every other page too).
 *
 * No hero section: main-page already renders the page title as the
 * h1, and a hero heading above it would make two.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "main-page",
      "settings": {
        "padding_top": 8,
        "padding_bottom": 0
      }
    },
    "form": {
      "type": "contact-form",
      "settings": {
        "heading": "Specify the <em><strong>DESIRED ITEM</strong></em> and <em><strong>SIZE</strong></em>, and we will respond to your request.",
        "heading_size": "h2",
        "color_scheme": "",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "form"
  ]
}
