/*
 * ------------------------------------------------------------
 * The shared default template, for any page with no template of
 * its own. It renders that page and nothing else.
 *
 * It used to carry the Sell To Us intro, the Formful sell form and
 * the sourcing form, with "main" disabled — so every default-template
 * page showed Sell To Us content and none of its own. That is why the
 * sourcing form appeared at the bottom of Sell To Us, and why
 * /pages/questions-answers rendered Sell To Us instead of being blank.
 * Those sections now live in page.sell.json and page.sourcing.json.
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "main-page",
      "settings": {
        "padding_top": 8,
        "padding_bottom": 12
      }
    }
  },
  "order": [
    "main"
  ]
}
