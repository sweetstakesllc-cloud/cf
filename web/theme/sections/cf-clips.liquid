{% comment %}
  Portrait stream-clip pair (live page). Mirrors .clips in web/live.html.
{% endcomment %}

<div class="cf">
  <section class="cf-section">
    <div class="wrap">
      {%- if section.settings.heading != blank -%}
        <div class="sec-head">
          <h2>{{ section.settings.heading }}</h2>
          {%- if section.settings.subtext != blank -%}<p class="sec-sub">{{ section.settings.subtext }}</p>{%- endif -%}
        </div>
      {%- endif -%}
      <div class="clips">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <div class="clip frame" data-label="Stream clip">
              {%- if block.settings.video != blank -%}
                {{ block.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
              {%- elsif block.settings.video_asset != blank -%}
                <video src="{{ block.settings.video_asset | asset_url }}" autoplay muted loop playsinline></video>
              {%- endif -%}
            </div>
            {%- if block.settings.caption != blank -%}<p class="clip-cap">{{ block.settings.caption }}</p>{%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "CF Stream Clips",
  "max_blocks": 2,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the Live" },
    { "type": "text", "id": "subtext", "label": "Subtext" }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Clip",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (uploaded)" },
        { "type": "text", "id": "video_asset", "label": "Video theme asset filename" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{ "name": "CF Stream Clips", "blocks": [{ "type": "clip" }, { "type": "clip" }] }]
}
{% endschema %}
