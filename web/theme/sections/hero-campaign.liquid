{% comment %}
  Campaign hero with blur-fill: a blurred cover copy sits behind a sharp
  object-fit:contain copy, so portrait campaign shots still fill the band.
  Mirrors the .hero block in web/index.html.
{% endcomment %}

<div class="cf">
  <section class="cf-section hero{% if section.settings.compact %} compact{% endif %}" style="padding:0">
    <div class="bg">
      {%- if section.settings.video_asset != blank -%}
        <video src="{{ section.settings.video_asset | asset_url }}" autoplay muted loop playsinline></video>
      {%- elsif section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 800 | image_tag: class: 'blur', alt: '', loading: 'eager' }}
        {{ section.settings.image | image_url: width: 1800 | image_tag: class: 'sharp', alt: section.settings.heading, loading: 'eager' }}
      {%- else -%}
        <img class="blur" src="https://circularfash.com/cdn/shop/files/F5976BE4-6FF3-4292-8726-79D7454A6B90.jpg?v=1785401188&width=800" alt="" aria-hidden="true">
        <img class="sharp" src="https://circularfash.com/cdn/shop/files/F5976BE4-6FF3-4292-8726-79D7454A6B90.jpg?v=1785401188&width=1600" alt="{{ section.settings.heading | escape }}">
      {%- endif -%}
    </div>
    <div class="hero-inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="sub">{{ section.settings.subtext }}</p>
      {%- endif -%}
      <div class="cta-row">
        {%- if section.settings.cta1_label != blank -%}
          <a class="btn solid" href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}">{{ section.settings.cta1_label }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_label != blank -%}
          <a class="btn ghost" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_label }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.live_line != blank -%}
        <span class="live-line"><span class="live-dot"></span>{{ section.settings.live_line }}</span>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "CF Campaign Hero",
  "settings": [
    { "type": "checkbox", "id": "compact", "label": "Compact height", "default": false },
    { "type": "text", "id": "video_asset", "label": "Background video asset filename", "info": "e.g. live-hero.mp4 (overrides the image)" },
    { "type": "image_picker", "id": "image", "label": "Campaign image", "info": "Ideally one landscape ~16:9 shot; portrait images get the blur-fill treatment." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Pre-Loved Luxury · Authenticated in Sweden" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Luxury deserves a second life" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Hand-picked pieces from Gucci, Louis Vuitton, Moncler and more. Every item verified by our experts." },
    { "type": "text", "id": "cta1_label", "label": "Primary button label", "default": "Shop All" },
    { "type": "url", "id": "cta1_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary button label", "default": "Sell Now" },
    { "type": "url", "id": "cta2_link", "label": "Secondary button link" },
    { "type": "text", "id": "live_line", "label": "Live line", "default": "Live on TikTok" }
  ],
  "presets": [{ "name": "CF Campaign Hero" }]
}
{% endschema %}
