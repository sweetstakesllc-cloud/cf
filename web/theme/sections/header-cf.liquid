{% comment %}
  Circular Fash header — utility bar + centered wordmark + category nav.
  Mirrors web/index.html. Cart link keeps the #cart-icon-bubble id so
  Refresh's cart drawer (rendered from theme.liquid) still opens and its
  count still live-updates via the cart-icon-bubble section.
{% endcomment %}

<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<div class="cf">
  <div class="util">
    <div class="wrap util-in">
      <a href="#footer-newsletter">{{ section.settings.util_left_label }}</a>
      <div class="util-right">
        {%- if section.settings.live_line != blank -%}
          <span class="muted">{{ section.settings.live_line }}</span>
        {%- endif -%}
        <a href="{{ section.settings.sell_link }}">{{ section.settings.sell_label }}</a>
        {%- if shop.customer_accounts_enabled -%}
          {%- if customer -%}
            <a href="{{ routes.account_url }}">Account</a>
          {%- else -%}
            <a href="{{ routes.account_login_url }}">Sign In</a>
          {%- endif -%}
        {%- endif -%}
        {%- comment -%}
          The region used to be a hardcoded line of text ("Sweden · SEK kr")
          while the store already sells into 46 countries across 27 currencies.
          Render Shopify's own localization form instead, so the figure a
          shopper sees is the one they will be charged. Falls back to the
          static line when only one country is configured, which is also what
          keeps the theme editor's preview honest.
        {%- endcomment -%}
        {%- if localization.available_countries.size > 1 -%}
          <localization-form class="cf-locale" data-prevent-hide>
            {%- form 'localization', id: 'CfHeaderCountryForm', class: 'localization-form' -%}
              <h2 class="visually-hidden" id="CfHeaderCountryLabel">
                {{ 'localization.country_label' | t }}
              </h2>
              {%- render 'country-localization', localPosition: 'CfHeaderCountry' -%}
            {%- endform -%}
          </localization-form>
        {%- elsif section.settings.region_line != blank -%}
          <span class="muted">{{ section.settings.region_line }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="masthead">
    <div class="wrap">
      <div class="mast-top">
        <div class="mast-left">{% render 'header-search-cf', input_id: 'Search-In-Modal-CF' %}</div>
        <a class="biglogo" href="{{ routes.root_url }}">{{ section.settings.wordmark | default: shop.name }}</a>
        <div class="mast-right">
          <a href="{{ routes.cart_url }}" id="cart-icon-bubble">Cart ({{ cart.item_count }})<span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span></a>
        </div>
      </div>
      <nav class="cats" aria-label="Main">
        {%- for link in section.settings.menu.links -%}
          {%- comment -%}
            A parent with children opens its dropdown instead of navigating. Its own
            URL is almost always a junk destination (BRANDS pointed at /collections,
            CATEGORIES at /collections/all) and the children are the real navigation.
          {%- endcomment -%}
          <div{% if link.links != blank %} class="has-drop"{% endif %}>
            {%- if link.links != blank -%}
              <button
                type="button"
                class="top"
                aria-expanded="false"
                aria-controls="cf-drop-{{ section.id }}-{{ forloop.index }}"
                {% if link.child_active %}aria-current="true"{% endif %}
              >
                {{ link.title }}
              </button>
              <div class="drop" id="cf-drop-{{ section.id }}-{{ forloop.index }}">
                <span class="head">{{ link.title }}</span>
                {%- comment -%}
                  Skip children that lead nowhere, on the same test the brands
                  page uses (sections/main-list-collections.liquid). Five of the
                  28 brands in the menu have no products at all, so the dropdown
                  was offering dead ends the brands page had already hidden —
                  the two views of the same menu disagreeing. A child that is
                  not a collection (a page, a policy) has no count to check and
                  is always kept.
                {%- endcomment -%}
                {%- for child in link.links -%}
                  {%- comment -%}
                    Tested as "has products", not "has zero products": a menu
                    item whose collection was deleted or unpublished has no
                    object at all, and `nil == 0` is false — so the negative
                    form would keep exactly the links that lead nowhere.
                  {%- endcomment -%}
                  {%- if child.type == 'collection_link' -%}
                    {%- unless child.object.all_products_count > 0 -%}
                      {%- continue -%}
                    {%- endunless -%}
                  {%- endif -%}
                  <a href="{{ child.url }}">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            {%- else -%}
              <a class="top" href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </nav>
    </div>
  </div>
</div>

<script>
  (function () {
    var nav = document.querySelector('.cf nav.cats');
    if (!nav) return;
    var items = nav.querySelectorAll('.has-drop');

    function close(item) {
      item.classList.remove('open');
      var btn = item.querySelector('.top');
      if (btn) btn.setAttribute('aria-expanded', 'false');
    }
    function closeAll(except) {
      items.forEach(function (item) {
        if (item !== except) close(item);
      });
    }

    items.forEach(function (item) {
      var btn = item.querySelector('.top');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var open = item.classList.contains('open');
        closeAll(item);
        item.classList.toggle('open', !open);
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    });

    document.addEventListener('click', function (event) {
      if (!nav.contains(event.target)) closeAll();
    });
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape') closeAll();
    });
  })();
</script>

{% schema %}
{
  "name": "CF Header",
  "class": "cf-header-section",
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Circular Fash" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "util_left_label", "label": "Utility bar left link", "default": "Join Our Newsletter" },
    { "type": "text", "id": "live_line", "label": "Live line (leave blank to hide)", "default": "Live on TikTok" },
    { "type": "text", "id": "sell_label", "label": "Sell link label", "default": "Sell Now" },
    { "type": "url", "id": "sell_link", "label": "Sell link" },
    { "type": "text", "id": "region_line", "label": "Region line", "default": "Sweden · SEK kr" }
  ]
}
{% endschema %}
