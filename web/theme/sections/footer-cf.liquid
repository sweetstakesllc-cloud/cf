{% comment %}
  Circular Fash footer — brand blurb, three link columns, newsletter.
  Mirrors web/index.html. Link columns come from navigation link lists so
  the client can edit them in admin; the newsletter is a real customer
  signup form.
{% endcomment %}

<div class="cf">
  <footer class="cf-footer" id="footer-newsletter">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <span class="flogo">{{ section.settings.wordmark | default: shop.name }}</span>
          <p style="max-width:30ch">{{ section.settings.blurb }}</p>
        </div>
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading | default: block.settings.menu.title }}</h4>
            <ul>
              {%- if block.type == 'links' -%}
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              {%- else -%}
                {%- if block.settings.label1 != blank -%}<li><a href="{{ block.settings.url1 }}">{{ block.settings.label1 }}</a></li>{%- endif -%}
                {%- if block.settings.label2 != blank -%}<li><a href="{{ block.settings.url2 }}">{{ block.settings.label2 }}</a></li>{%- endif -%}
                {%- if block.settings.label3 != blank -%}<li><a href="{{ block.settings.url3 }}">{{ block.settings.label3 }}</a></li>{%- endif -%}
                {%- if block.settings.label4 != blank -%}<li><a href="{{ block.settings.url4 }}">{{ block.settings.label4 }}</a></li>{%- endif -%}
              {%- endif -%}
            </ul>
          </div>
        {%- endfor -%}
        <div>
          <h4>{{ section.settings.newsletter_heading }}</h4>
          <p>{{ section.settings.newsletter_text }}</p>
          {% form 'customer', class: 'newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="newsletter">
              <input
                id="CF-NewsletterEmail"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                required
                placeholder="Email address"
                aria-label="Email address"
                autocomplete="email"
              >
              <button type="submit">Sign Up</button>
            </div>
            {%- if form.errors -%}
              <p style="font-size:12.5px;margin-top:8px">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p style="font-size:12.5px;margin-top:8px">Thanks for subscribing.</p>
            {%- endif -%}
          {% endform %}
        </div>
      </div>
      <div class="foot-bottom">
        <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
        <span>
          {%- assign social_count = 0 -%}
          {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}">TikTok</a>{%- assign social_count = 1 -%}{%- endif -%}
          {%- if section.settings.instagram != blank -%}{% if social_count > 0 %} &nbsp;·&nbsp; {% endif %}<a href="{{ section.settings.instagram }}">Instagram</a>{%- assign social_count = 1 -%}{%- endif -%}
          {%- if section.settings.facebook != blank -%}{% if social_count > 0 %} &nbsp;·&nbsp; {% endif %}<a href="{{ section.settings.facebook }}">Facebook</a>{%- assign social_count = 1 -%}{%- endif -%}
          {%- if section.settings.trustpilot != blank -%}{% if social_count > 0 %} &nbsp;·&nbsp; {% endif %}<a href="{{ section.settings.trustpilot }}">Trustpilot</a>{%- endif -%}
        </span>
      </div>
    </div>
  </footer>
</div>

{% schema %}
{
  "name": "CF Footer",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "Circular Fash" },
    { "type": "text", "id": "blurb", "label": "Blurb", "default": "Authenticated pre-owned luxury fashion, shipped from Sweden to the world." },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join Our Newsletter" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "New drops and live schedule, straight to your inbox." },
    { "type": "url", "id": "tiktok", "label": "TikTok URL" },
    { "type": "url", "id": "instagram", "label": "Instagram URL" },
    { "type": "url", "id": "facebook", "label": "Facebook URL" },
    { "type": "url", "id": "trustpilot", "label": "Trustpilot URL" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column (menu)",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    },
    {
      "type": "custom",
      "name": "Link column (manual)",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "label1", "label": "Link 1 label" },
        { "type": "url", "id": "url1", "label": "Link 1 URL" },
        { "type": "text", "id": "label2", "label": "Link 2 label" },
        { "type": "url", "id": "url2", "label": "Link 2 URL" },
        { "type": "text", "id": "label3", "label": "Link 3 label" },
        { "type": "url", "id": "url3", "label": "Link 3 URL" },
        { "type": "text", "id": "label4", "label": "Link 4 label" },
        { "type": "url", "id": "url4", "label": "Link 4 URL" }
      ]
    }
  ]
}
{% endschema %}
