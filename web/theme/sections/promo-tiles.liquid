{% comment %}
  Two-up promo tiles ("Shop With Us on TikTok Live" / "Ways to Sell").
  Each tile takes a video (theme asset or uploaded file) or an image.
  Mirrors the .tiles block in web/index.html.
{% endcomment %}

<div class="cf">
  <section class="cf-section" style="padding-top:0">
    <div class="wrap tiles">
      {%- for block in section.blocks -%}
        <div class="tile" {{ block.shopify_attributes }}>
          <div class="media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, controls: false }}
            {%- elsif block.settings.video_asset != blank -%}
              <video src="{{ block.settings.video_asset | asset_url }}" autoplay muted loop playsinline></video>
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1200 | image_tag: alt: block.settings.heading, loading: 'lazy' }}
            {%- endif -%}
          </div>
          <div class="tile-inner">
            {%- if block.settings.kicker != blank -%}
              <span class="kicker">{{ block.settings.kicker }}</span>
            {%- endif -%}
            <h3>{{ block.settings.heading }}</h3>
            {%- if block.settings.button_label != blank -%}
              <a class="btn{% if block.settings.button_solid %} solid{% endif %}" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "CF Promo Tiles",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (uploaded)" },
        { "type": "text", "id": "video_asset", "label": "Video theme asset filename", "info": "Fallback if no video uploaded, e.g. live-hero.mp4" },
        { "type": "image_picker", "id": "image", "label": "Image (used if no video)" },
        { "type": "text", "id": "kicker", "label": "Kicker" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "checkbox", "id": "button_solid", "label": "Solid button", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "CF Promo Tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
